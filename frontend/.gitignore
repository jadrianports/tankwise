# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Playwright run artifacts -- traces, videos, and HTML reports can embed
# request URLs carrying the public Mapbox token, and none of them is a
# deliverable (the deliverables are the PNGs a capture spec writes
# directly into docs/screenshots).
test-results/
playwright-report/
blob-report/
playwright/.cache/

# scripts/flake-hunt.mjs run artifacts -- per-run vitest JSON reports and
# combined-output logs, retained only for a failing run and used purely
# for local diagnosis. Never a deliverable.
.flake-hunt/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
